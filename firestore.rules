rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 유저 프로필 문서
    match /users/{userId} {
      // 읽기: 누구나 가능 (공개 프로필 페이지)
      allow read: if true;
      
      // 쓰기: 로그인된 본인만 가능
      // create: 신규 가입 시 초기 데이터 생성
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // update: 이름, 소개글 등 변경 (단, displayName은 변경 불가)
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.displayName == resource.data.displayName;
      
      // 삭제: 본인만 가능 (현재 UI에는 없지만 보안상 설정)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // 링크 서브 컬렉션
      match /links/{linkId} {
        // 읽기: 누구나 가능
        allow read: if true;
        
        // 생성/삭제: 본인만 가능
        allow create, delete: if request.auth != null && request.auth.uid == userId;
        
        // 업데이트:
        allow update: if (
          // 1. 본인이 수정하는 경우 (제목, URL, 아이콘 등)
          (request.auth != null && request.auth.uid == userId) ||
          // 2. 누구나 'clicks' 필드만 수정하는 경우 (공개 페이지 클릭 집계)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
          )
        );
      }
    }

    // [제안] 디스플레이 네임 중복 체크를 위한 추가 보안 규칙 (필요 시 도입)
    // 현재는 frontend에서 체크하고 있으나, 더 완벽한 보안을 위해서는 
    // 별도의 displayNames 컬렉션을 운영하는 것이 좋습니다.
  }
}
